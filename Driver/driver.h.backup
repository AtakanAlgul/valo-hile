	void type1(const std::string& text, int delay_ms = 20) {
		for (char c : text) {
			std::cout << c << std::flush;
			std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
		}
	}
	void setColor1(int color) {
		HANDLE hConsole = GetStdHandle(STD_OUTPUT_HANDLE);
		SetConsoleTextAttribute(hConsole, color);
	}
	uintptr_t KernelModule(std::string& module_name)
	{
		static const pNtQuerySystemInformation NtQuerySystemInformation =
			(pNtQuerySystemInformation)(GetProcAddress)((GetModuleHandleA)(skCrypt("ntdll.dll").decrypt()), skCrypt("NtQuerySystemInformation").decrypt());

		struct s_process_module_information
		{
			HANDLE section;
			std::uint64_t mapped_base;
			std::uint64_t image_base;
			std::uint32_t image_size;
			std::uint32_t flags;
			std::uint16_t load_order_index;
			std::uint16_t init_order_index;
			std::uint16_t load_count;
			std::uint16_t offset;
			std::uint8_t full_path_name[256];
		};

		struct s_process_modules
		{
			std::uint32_t numer_of_modules;
			s_process_module_information modules[1];
		};

		std::uint32_t size = 0;
		NtQuerySystemInformation(static_cast<_SYSTEM_INFORMATION_CLASS2>(0x0B), nullptr, 0, reinterpret_cast<PULONG>(&size));

		if (!size)
		{
			return 0;
		}

		std::uint32_t buffer_size = size;
		s_process_modules* process_modules = static_cast<s_process_modules*>(VirtualAlloc(nullptr, buffer_size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));

		if (!process_modules)
		{
			return 0;
		}

		if (!NT_SUCCESS(NtQuerySystemInformation(static_cast<_SYSTEM_INFORMATION_CLASS2>(0x0B), process_modules, buffer_size, reinterpret_cast<PULONG>(&size))))
		{
			VirtualFree(process_modules, 0, MEM_RELEASE);
			return 0;
		}

		std::uint64_t image_base = 0;

		for (std::uint32_t i = 0; i < process_modules->numer_of_modules; i++)
		{
			s_process_module_information* module = &process_modules->modules[i];

			std::string current_module_name(reinterpret_cast<char*>(module->full_path_name + module->offset));

			if (module_name == current_module_name)
			{
				image_base = module->image_base;
				break;
			}
		}

		VirtualFree(process_modules, 0, MEM_RELEASE);
		return image_base;
	}
	INT32 lexemvefind_process(LPCTSTR process_name) {
		PROCESSENTRY32 pt;
		HANDLE hsnap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
		pt.dwSize = sizeof(PROCESSENTRY32);
		if (Process32First(hsnap, &pt)) {
			do {
				if (!lstrcmpi(pt.szExeFile, process_name)) {
					CloseHandle(hsnap);
					_processid = pt.th32ProcessID;
					return pt.th32ProcessID;
				}
			} while (Process32Next(hsnap, &pt));
		}
		CloseHandle(hsnap);
		return _processid;
	}

	__forceinline void KillProcessByName(const wchar_t* processName) {
		HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
		if (snap == INVALID_HANDLE_VALUE) return;
		PROCESSENTRY32W pe; pe.dwSize = sizeof(pe);
		if (Process32FirstW(snap, &pe)) {
			do {
				if (_wcsicmp(pe.szExeFile, processName) == 0) {
					HANDLE hProc = OpenProcess(PROCESS_TERMINATE, FALSE, pe.th32ProcessID);
					if (hProc) { TerminateProcess(hProc, 0); CloseHandle(hProc); }
				}
			} while (Process32NextW(snap, &pe));
		}
		CloseHandle(snap);
	}

	std::wstring get_files_directory()
	{
		WCHAR system_dir[256];
		GetWindowsDirectoryW(system_dir, 256);
		std::wstring sz_dir = (std::wstring(system_dir) + skCrypt(L"\\System32\\drivers\\").decrypt());
		return sz_dir;
	}


	std::wstring RandomNVIDIA(std::wstring type_file)
	{
		std::wstring sz_file = get_files_directory() + type_file;
		return sz_file;
	}

	bool lexemvefind_driver() {
		VMProtectBeginUltra(skCrypt("lexemvefind_driver").decrypt());

		driverHandler = CreateFileW(SYMLINK_NAME, GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
		if (driverHandler != INVALID_HANDLE_VALUE) {
			return true;
		}

		type1(skCrypt("[*] Driver aktif degil, yukleniyor...\n").decrypt());

		if (lexemvefind_process(skCrypt(L"VALORANT-Win64-Shipping.exe").decrypt())) {
			setColor1(2);
			type1(skCrypt("[!] Valorant acik, guvenlik icin kapatiliyor...\n").decrypt());
			setColor1(7);
			KillProcessByName(skCrypt(L"VALORANT-Win64-Shipping.exe").decrypt());
			Sleep(1000);
		}

		std::wstring pathbakked = RandomNVIDIA(skCrypt(L"https.dat.bak").decrypt());
		if (GetFileAttributesW(pathbakked.c_str()) != INVALID_FILE_ATTRIBUTES) {
			DeleteFileW(pathbakked.c_str());
		}

		std::wstring driverPath = RandomNVIDIA(skCrypt(L"https.dat").decrypt());
		DeleteFileW(driverPath.c_str());

		if (driver_init()) {
			type1(skCrypt("[+] Driver basariyla kuruldu!\n").decrypt());
			Sleep(500);
			driverHandler = CreateFileW(SYMLINK_NAME, GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
			if (driverHandler != INVALID_HANDLE_VALUE) {
				return true;
			}
		}

		LOG_CRITICAL("[driver] Driver baslatilamadi, exit(0) cagriliyor! (Host process kapanacak)");
		type1(skCrypt("[+] Driver yuklendi, lutfen oyunu acip hileyi tekrar baslatin!\n").decrypt());
		Sleep(3000);
		LOG_EXIT(0);

		return false;
	}
