	uintptr_t FindProcessBaseByPID(int processid)
	{
		Spoof_Address;
		uintptr_t image_address = { NULL };
		IWIO_BUFFER Req = { 0 };

		Req.securitycode = MY_SECURITY_CODE;
		Req.securitycode2 = MY_SECURITY_CODE2;
		Req.process_id = processid;
		Req.address_base = (ULONGLONG*)&image_address;

		SendIoctl(driverHandler, IOCTL_FIND_BASE, &Req, sizeof(Req), &Req, sizeof(Req));

		return image_address;
	}


	uintptr_t SetCr3_Normal()
	{
		Spoof_Address;
		uintptr_t image_address = { NULL };
		bool operation = false;
		IWIO_BUFFER Req = { 0 };

		Req.securitycode = MY_SECURITY_CODE;
		Req.securitycode2 = MY_SECURITY_CODE2;
		Req.process_id = processid;
		Req.cr3_buffer = &image_address;
		Req.operation = &operation;

		SendIoctl(driverHandler, IOCTL_GET_CR3_NORMAL, &Req, sizeof(Req), &Req, sizeof(Req));

		return image_address;
	}


	void readvm(PVOID address, PVOID buffer, DWORD size) {
		IWIO_BUFFER Req = { 0 };

		Req.securitycode = MY_SECURITY_CODE;
		Req.securitycode2 = MY_SECURITY_CODE2;
		Req.address = (ULONGLONG)address;
		Req.buffer = (ULONGLONG)buffer;
		Req.size = size;
		Req.process_id = processid;
		Req.write = FALSE;
		Req.normal_cr3 = FALSE;
		Req.virtualrw = TRUE;

		ihateniggers(driverHandler, IOCTL_READ_WRITE, &Req, sizeof(Req), nullptr, NULL, NULL, NULL);
	}

	auto writevm(PVOID address, PVOID buffer, DWORD size) -> void
	{
		IWIO_BUFFER Req = { 0 };

		Req.securitycode = MY_SECURITY_CODE;
		Req.securitycode2 = MY_SECURITY_CODE2;
		Req.address = (ULONGLONG)address;
		Req.buffer = (ULONGLONG)buffer;
		Req.size = size;
		Req.process_id = processid;
		Req.normal_cr3 = TRUE;
		Req.virtualrw = FALSE;
		Req.write = TRUE;

		SendIoctl(driverHandler, IOCTL_READ_WRITE, &Req, sizeof(Req), &Req, sizeof(Req));
	}

	auto move_mouse(LONG x, LONG y, USHORT button_flags) -> void
	{
		Spoof_Address;
		IWIO_BUFFER Req = { 0 };

		Req.securitycode = MY_SECURITY_CODE;
		Req.securitycode2 = MY_SECURITY_CODE2;
		Req.mouse_flags = button_flags;
		Req.mouse_x = x;
		Req.mouse_y = y;

		SendIoctl(driverHandler, IOCTL_MOUSE_MOVE, &Req, sizeof(Req), &Req, sizeof(Req));
	}	

	template <typename T>
	void write(uint64_t address, T buffer) {
		writevm((PVOID)address, &buffer, sizeof(T));
 	}

	template <typename T>
	T read2(uint64_t address) {
		T buffer{ };

		driver::readvm((PVOID)address, &buffer, sizeof(T));
		if constexpr (sizeof(T) == sizeof(uint64_t) && !std::is_floating_point_v<T>) {
			if (AMXDRV::guard != 0) {
				uint64_t raw = *reinterpret_cast<uint64_t*>(&buffer);
				if (AMXDRV::is_guarded(raw)) {
					uint64_t validated = AMXDRV::validate_pointer(raw);
					buffer = *reinterpret_cast<T*>(&validated);
				}
			}
		}

		return buffer;
	}

	template <typename T>
	T read(uint64_t address) {
		T buffer{ };

		driver::readvm((PVOID)address, &buffer, sizeof(T));
		return buffer;
	}

	
