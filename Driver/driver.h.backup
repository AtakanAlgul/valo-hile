	typedef BOOL(WINAPI* DeviceIoControl_t)(
		HANDLE       hDevice,
		DWORD        dwIoControlCode,
		LPVOID       lpInBuffer,
		DWORD        nInBufferSize,
		LPVOID       lpOutBuffer,
		DWORD        nOutBufferSize,
		LPDWORD      lpBytesReturned,
		LPOVERLAPPED lpOverlapped
		);

	DeviceIoControl_t DeviceControlAveris = reinterpret_cast<DeviceIoControl_t>(pDeviceIoControl);

	void ihateniggers(HANDLE hDevice,
		DWORD        dwIoControlCode,
		LPVOID       lpInBuffer,
		DWORD        nInBufferSize,
		LPVOID       lpOutBuffer,
		DWORD        nOutBufferSize,
		LPDWORD      lpBytesReturned,
		LPOVERLAPPED lpOverlapped)
	{
		DeviceControlAveris(hDevice, dwIoControlCode, lpInBuffer, nInBufferSize, lpOutBuffer, nOutBufferSize, lpBytesReturned, lpOverlapped);
	}


	bool SendIoctl(HANDLE hDevice, DWORD ioctlCode, LPVOID inBuffer, DWORD inBufferSize, LPVOID outBuffer, DWORD outBufferSize)
	{
		DWORD bytesReturned;
		ihateniggers(
			hDevice,
			ioctlCode,
			inBuffer,
			inBufferSize,
			outBuffer,
			outBufferSize,
			&bytesReturned,
			NULL
		);
		return true; 
	}


	INT32 find_process(LPCTSTR process_name) {
		PROCESSENTRY32 pt;
		HANDLE hsnap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
		pt.dwSize = sizeof(PROCESSENTRY32);
		if (Process32First(hsnap, &pt)) {
			do {
				if (!lstrcmpi(pt.szExeFile, process_name)) {
					CloseHandle(hsnap);
					return pt.th32ProcessID;

				}
			} while (Process32Next(hsnap, &pt));
		}
		CloseHandle(hsnap);

		return { NULL };
	}

