	bool is_valid(const uint64_t address)
	{
		if (address == 0 || address == 0xCCCCCCCCCCCCCCCC || address == 0xFFFFFFFFFFFFFFFF)
			return false;

		if (address <= 0x400000 || address > 0x7FFFFFFFFFFFFFFF)
			return false;

		return true;
	}
